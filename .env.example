# ==========================================
# BibliON Campus — Variáveis de Ambiente
# Copie este arquivo para .env e preencha
# ==========================================

# --- Banco de Dados ---
POSTGRES_USER=biblion
POSTGRES_PASSWORD=biblion_secret
POSTGRES_DB=biblion_campus
DATABASE_URL="postgresql://biblion:biblion_secret@postgres:5432/biblion_campus"

# --- JWT ---
# Coloque qualquer texto longo e aleatório (mínimo 32 caracteres)
JWT_SECRET=coloque_aqui_um_texto_longo_e_aleatorio_12345
JWT_REFRESH_SECRET=coloque_aqui_outro_texto_diferente_do_acima_67890
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Groq API (IA gratuita) ---
# Obtenha em: https://console.groq.com → API Keys → Create API Key
# A chave começa com: gsk_
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Supabase Storage (armazenamento de PDFs) ---
# Obtenha em: https://supabase.com → seu projeto → Configurações → Em geral
SUPABASE_URL=https://xxxxxxxxxxxxxx.supabase.co
# Obtenha em: Configurações → Chaves de API → Chaves secretas → copie a sb_secret_...
SUPABASE_SERVICE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Redis (cache interno — deixe assim se usar Docker) ---
REDIS_URL=redis://redis:6379

# --- Configurações do servidor ---
PORT=3001
NODE_ENV=development

# --- Frontend (URL da API que o Next.js vai chamar) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
